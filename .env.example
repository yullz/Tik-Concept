# ---- ElevenLabs (direct API) ----
ELEVENLABS_API_KEY=
# Lock ONE voice id for the whole channel. Pick it once (docs/06-voice-and-sound.md), never change mid-season.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4   # confirm with: python3 -m pipeline audition --list-models
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_192   # needs Creator tier or above; use mp3_44100_128 on a lower plan
# ---- Higgsfield Cloud API (REST). The MCP route is verified; REST endpoints are configurable. ----
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
HIGGSFIELD_T2I_PATH=/v1/text2image/{model}
HIGGSFIELD_I2V_PATH=/v1/image2video/{model}
HIGGSFIELD_STATUS_PATH=/v1/requests/{request_id}
# ---- Defaults ----
KEYFRAME_MODEL=nano_banana_pro
VIDEO_MODEL=kling3_0
